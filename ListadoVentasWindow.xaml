<Window x:Class="Vistas.ListadoVentasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Listado de Ventas" Height="520" Width="920"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filtros -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Desde:" VerticalAlignment="Center"/>
            <DatePicker x:Name="dpDesde" Width="110" Height="26"/>
            <Label Content="Hasta:" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <DatePicker x:Name="dpHasta" Width="110" Height="26"/>
            <Label Content="Vendedor:" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <ComboBox x:Name="cbVendedor" Width="180" Height="26" DisplayMemberPath="Value" SelectedValuePath="Key"/>
            <Button x:Name="btnFiltrar" Content="Filtrar" Width="70" Height="26" Margin="10,0,0,0"
                    Style="{StaticResource EstiloBoton}" Click="btnFiltrar_Click"/>
            <Button x:Name="btnLimpiarFiltros" Content="Limpiar" Width="70" Height="26" Margin="0"
                    Style="{StaticResource EstiloBoton}" Click="btnLimpiarFiltros_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgVentas" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nº" Binding="{Binding Path=NroFactura}" Width="50"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Path=Fecha, StringFormat=dd/MM/yyyy}" Width="80"/>
                <DataGridTextColumn Header="Vendedor" Binding="{Binding Path=Vendedor}" Width="*"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding Path=Cliente}" Width="*"/>
                <DataGridTextColumn Header="Producto" Binding="{Binding Path=Producto}" Width="*"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding Path=Precio, StringFormat=N2}" Width="80"/>
                <DataGridTextColumn Header="Cant." Binding="{Binding Path=Cantidad}" Width="50"/>
                <DataGridTextColumn Header="Importe" Binding="{Binding Path=Importe, StringFormat=N2}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="lblCantidad" Margin="0,0,20,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="lblTotal" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnAnular" Content="Anular venta" Style="{StaticResource EstiloBoton}" Click="btnAnular_Click"/>
                <Button x:Name="btnResumen" Content="Resumen" Style="{StaticResource EstiloBoton}" Click="btnResumen_Click"/>
                <Button x:Name="btnExportar" Content="Exportar CSV" Style="{StaticResource EstiloBoton}" Click="btnExportar_Click"/>
                <Button x:Name="btnCerrar" Content="Cerrar" Style="{StaticResource EstiloBoton}" Click="btnCerrar_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
