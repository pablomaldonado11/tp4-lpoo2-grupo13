<Window x:Class="Vistas.ResumenVentasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resumen de Ventas" Height="480" Width="560"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="lblPeriodo" Margin="0,0,0,10"/>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Top" Text="Ventas por vendedor" FontWeight="Bold" Margin="0,0,0,4"/>
            <DataGrid x:Name="dgVendedores" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Legajo" Binding="{Binding Path=Legajo}" Width="70"/>
                    <DataGridTextColumn Header="Vendedor" Binding="{Binding Path=Vendedor}" Width="*"/>
                    <DataGridTextColumn Header="Ventas" Binding="{Binding Path=Ventas}" Width="60"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Path=Total, StringFormat=N2}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Top" Text="Ventas por producto" FontWeight="Bold" Margin="0,0,0,4"/>
            <DataGrid x:Name="dgProductos" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código" Binding="{Binding Path=CodProducto}" Width="70"/>
                    <DataGridTextColumn Header="Producto" Binding="{Binding Path=Producto}" Width="*"/>
                    <DataGridTextColumn Header="Unidades" Binding="{Binding Path=Unidades}" Width="70"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Path=Total, StringFormat=N2}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnCerrar" Content="Cerrar" Style="{StaticResource EstiloBoton}" Click="btnCerrar_Click"/>
        </StackPanel>
    </Grid>
</Window>
