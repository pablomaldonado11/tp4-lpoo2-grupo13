<Window x:Class="Vistas.ListadoProveedoresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Listado de Proveedores" Height="380" Width="650"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Filtrar por razón social:"/>
            <TextBox x:Name="txtFiltro" Width="220" TextChanged="txtFiltro_TextChanged"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgProveedores" AutoGenerateColumns="True" IsReadOnly="True"/>

        <TextBlock Grid.Row="2" x:Name="lblCantidad" Margin="0,8,0,0"/>
    </Grid>
</Window>
