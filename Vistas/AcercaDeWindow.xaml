<Window x:Class="Vistas.AcercaDeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acerca de - Grupo 13" Height="680" Width="720"
        MinHeight="550" MinWidth="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Información del Grupo y Aplicación -->
        <Border Grid.Row="0" Background="#F0F4F8" BorderBrush="#CBD5E1" BorderThickness="1"
                CornerRadius="8" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Sistema de Gestión de Mueblería" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Laboratorio de Programación Orientada a Objetos II - TP Final" FontSize="12" Foreground="#64748B" Margin="0,2,0,8"/>
                    
                    <TextBlock Text="Integrantes del Grupo 13:" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,2,0,4"/>
                    <Grid Margin="5,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="• Marcos Chambi" FontSize="12" Foreground="#1E293B" Margin="0,1"/>
                            <TextBlock Text="• Pablo Maldonado" FontSize="12" Foreground="#1E293B" Margin="0,1"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="• Agustín Callata" FontSize="12" Foreground="#1E293B" Margin="0,1"/>
                            <TextBlock Text="• Luis Barrionuevo" FontSize="12" Foreground="#1E293B" Margin="0,1"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Badge Grupo 13 -->
                <Border Grid.Column="1" Background="#2A75D3" CornerRadius="6" Padding="14,10" VerticalAlignment="Center" Margin="10,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="GRUPO" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="13" FontSize="26" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Área de Reproducción de Video -->
        <Border Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                CornerRadius="8" ClipToBounds="True">
            <Grid>
                <MediaElement x:Name="meReproductor"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Stop"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              MediaOpened="meReproductor_MediaOpened"
                              MediaEnded="meReproductor_MediaEnded"
                              MediaFailed="meReproductor_MediaFailed"/>
            </Grid>
        </Border>

        <!-- Controles del Reproductor -->
        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="8" Padding="12" Margin="0,10,0,0">
            <StackPanel>
                <!-- Slider de Progreso y Tiempo -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="sliderProgreso" Grid.Column="0"
                            VerticalAlignment="Center"
                            IsMoveToPointEnabled="True"
                            PreviewMouseLeftButtonDown="sliderProgreso_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="sliderProgreso_PreviewMouseLeftButtonUp"
                            Thumb.DragStarted="sliderProgreso_DragStarted"
                            Thumb.DragCompleted="sliderProgreso_DragCompleted"
                            ValueChanged="sliderProgreso_ValueChanged"
                            Cursor="Hand"/>
                    <TextBlock x:Name="lblTiempo" Grid.Column="1"
                               Text="00:00 / 00:00"
                               FontFamily="Consolas"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </Grid>

                <!-- Botones de Control: Play, Pause, Stop, Volumen, Cargar Video, Cerrar -->
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button x:Name="btnPlay" Content="▶ Play" Width="75" Height="30" Margin="0,0,6,0"
                                Click="btnPlay_Click" ToolTip="Reproducir"/>
                        <Button x:Name="btnPause" Content="⏸ Pausa" Width="75" Height="30" Margin="0,0,6,0"
                                Click="btnPause_Click" ToolTip="Pausar"/>
                        <Button x:Name="btnStop" Content="⏹ Stop" Width="75" Height="30" Margin="0,0,12,0"
                                Click="btnStop_Click" ToolTip="Detener"/>

                        <!-- Control de Volumen -->
                        <TextBlock Text="🔊" VerticalAlignment="Center" FontSize="14" Margin="0,0,4,0"/>
                        <Slider x:Name="sliderVolumen" Width="80" Minimum="0" Maximum="1" Value="0.7"
                                SmallChange="0.05" LargeChange="0.1"
                                VerticalAlignment="Center"
                                ValueChanged="sliderVolumen_ValueChanged"
                                ToolTip="Volumen"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="btnCargarVideo" Content="📂 Cargar video..." Height="30" Padding="10,0" Margin="0,0,8,0"
                                Click="btnCargarVideo_Click" ToolTip="Seleccionar otro archivo de video"/>
                        <Button x:Name="btnCerrar" Content="Cerrar" Width="75" Height="30"
                                Click="btnCerrar_Click"/>
                    </StackPanel>
                </DockPanel>

                <!-- Indicador de archivo de video actual -->
                <TextBlock x:Name="lblEstadoVideo" Text="Cargando video..." FontSize="11" Foreground="#64748B"
                           Margin="2,6,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>