<Window x:Class="Vistas.UsuarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ABM de Usuarios" Height="700" Width="760"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Style="{StaticResource EstiloVentanaDegradado}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Usuarios" FontSize="20" FontWeight="Bold" Margin="5"/>

        <WrapPanel Grid.Row="1" Margin="0,8">
            <Button x:Name="btnNuevo" Content="Nuevo" Width="100" Click="btnNuevo_Click"
                    Style="{StaticResource EstiloBotonIcono}" Tag="{StaticResource IconoNuevo}"
                    ToolTip="Crear un usuario nuevo"/>
            <Button x:Name="btnModificar" Content="Modificar" Width="100" Click="btnModificar_Click"
                    Style="{StaticResource EstiloBotonIcono}" Tag="{StaticResource IconoModificar}"
                    ToolTip="Modificar el usuario seleccionado"/>
            <Button x:Name="btnEliminar" Content="Eliminar" Width="100" Click="btnEliminar_Click"
                    Style="{StaticResource EstiloBotonIcono}" Tag="{StaticResource IconoEliminar}"
                    ToolTip="Eliminar el usuario seleccionado"/>
            <Button x:Name="btnGuardar" Content="Guardar" Width="100" Click="btnGuardar_Click"
                    Style="{StaticResource EstiloBotonIcono}" Tag="{StaticResource IconoGuardar}"
                    ToolTip="Guardar los datos del usuario"/>
            <Button x:Name="btnCancelar" Content="Cancelar" Width="100" Click="btnCancelar_Click"
                    Style="{StaticResource EstiloBotonIcono}" Tag="{StaticResource IconoCancelar}"
                    ToolTip="Cancelar la edición"/>
        </WrapPanel>

        <Grid Grid.Row="2" Margin="30,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/><RowDefinition Height="40"/>
                <RowDefinition Height="40"/><RowDefinition Height="40"/>
                <RowDefinition Height="40"/><RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <Label Content="Usuario:"/>
            <TextBox Grid.Column="1" x:Name="txtUsuario" MaxLength="30"
                     Style="{StaticResource EstiloTextBox}"/>
            <Label Grid.Row="1" Content="Apellido:"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtApellido" MaxLength="50"
                     Style="{StaticResource EstiloTextBox}"/>
            <Label Grid.Row="2" Content="Nombre:"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtNombre" MaxLength="50"
                     Style="{StaticResource EstiloTextBox}"/>
            <Label Grid.Row="3" Content="Contraseña:"/>
            <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="txtPassword"
                         MaxLength="30" Height="28" Margin="5" Padding="3"/>
            <Label Grid.Row="4" Content="Repetir contraseña:"/>
            <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="txtConfirmar"
                         MaxLength="30" Height="28" Margin="5" Padding="3"/>
            <Label Grid.Row="5" Content="Rol:"/>
            <ComboBox Grid.Row="5" Grid.Column="1" x:Name="cmbRol" Height="28"
                      Width="180" Margin="5" HorizontalAlignment="Left"/>
            <Label Grid.Row="6" Content="Estado:"/>
            <CheckBox Grid.Row="6" Grid.Column="1" x:Name="chkActivo"
                      Content="Usuario activo" Margin="5" VerticalAlignment="Center"/>
        </Grid>

        <DataGrid x:Name="dgvUsuarios" Grid.Row="3" Margin="5"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  SelectionChanged="dgvUsuarios_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Usuario" Binding="{Binding NombreUsuario}" Width="120"/>
                <DataGridTextColumn Header="Apellido" Binding="{Binding Apellido}" Width="*"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="90"/>
                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="65"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button x:Name="btnPrimero" Content="Primero" Width="90" Click="btnPrimero_Click"
                    Style="{StaticResource EstiloBotonIcono}" Tag="{StaticResource IconoPrimero}"
                    ToolTip="Ir al primer usuario"/>
            <Button x:Name="btnAnterior" Content="Anterior" Width="90" Click="btnAnterior_Click"
                    Style="{StaticResource EstiloBotonIcono}" Tag="{StaticResource IconoAnterior}"
                    ToolTip="Ir al usuario anterior"/>
            <Button x:Name="btnSiguiente" Content="Siguiente" Width="90" Click="btnSiguiente_Click"
                    Style="{StaticResource EstiloBotonIcono}" Tag="{StaticResource IconoSiguiente}"
                    ToolTip="Ir al usuario siguiente"/>
            <Button x:Name="btnUltimo" Content="Último" Width="90" Click="btnUltimo_Click"
                    Style="{StaticResource EstiloBotonIcono}" Tag="{StaticResource IconoUltimo}"
                    ToolTip="Ir al último usuario"/>
            <Button x:Name="btnSalir" Content="Salir" Width="90" Margin="70,5,5,5"
                    Click="btnSalir_Click" Style="{StaticResource EstiloBotonIcono}"
                    Tag="{StaticResource IconoSalir}" ToolTip="Cerrar el ABM de usuarios"/>
        </StackPanel>
    </Grid>
</Window>
