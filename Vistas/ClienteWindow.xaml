<Window x:Class="Vistas.ClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ABM de Clientes" Height="420" Width="800"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="ABM de Clientes" FontSize="20" FontWeight="Bold" Margin="5"/>
        <WrapPanel Grid.Row="1" Margin="0,8">
            <Button x:Name="btnNuevo" Content="Nuevo" Width="75" Height="30" Margin="3" Click="btnNuevo_Click" Style="{StaticResource EstiloBoton}"/>
            <Button x:Name="btnModificar" Content="Modificar" Width="75" Height="30" Margin="3" Click="btnModificar_Click" Style="{StaticResource EstiloBoton}"/>
            <Button x:Name="btnEliminar" Content="Eliminar" Width="75" Height="30" Margin="3" Click="btnEliminar_Click" Style="{StaticResource EstiloBoton}"/>
            <Button x:Name="btnGuardar" Content="Guardar" Width="75" Height="30" Margin="3" Click="btnGuardar_Click" Style="{StaticResource EstiloBoton}"/>
            <Button x:Name="btnCancelar" Content="Cancelar" Width="75" Height="30" Margin="3" Click="btnCancelar_Click" Style="{StaticResource EstiloBoton}"/>
        </WrapPanel>
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="lstClientes" DisplayMemberPath="Apellido" SelectionChanged="lstClientes_SelectionChanged" Margin="0,0,10,0"/>
            <Grid x:Name="datosCliente" Grid.Column="1" Margin="10,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                <Label Grid.Row="0" Content="DNI:"/><TextBox Grid.Row="0" Grid.Column="1" x:Name="txtDNI" Height="25" MaxLength="8" Style="{StaticResource EstiloTextBox}" Text="{Binding DNI, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Grid.Row="1" Content="Apellido:"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="txtApellido" Height="25" MaxLength="50" Style="{StaticResource EstiloTextBox}" Text="{Binding Apellido, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Grid.Row="2" Content="Nombre:"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="txtNombre" Height="25" MaxLength="50" Style="{StaticResource EstiloTextBox}" Text="{Binding Nombre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Grid.Row="3" Content="Dirección:"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="txtDireccion" Height="25" MaxLength="100" Style="{StaticResource EstiloTextBox}" Text="{Binding Direccion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button x:Name="btnPrimero" Content="Primero" Width="75" Margin="3" Style="{StaticResource EstiloBoton}" Click="btnPrimero_Click" />
            <Button x:Name="btnAnterior" Content="Anterior" Width="75" Margin="3" Style="{StaticResource EstiloBoton}" Click="btnAnterior_Click" />
            <Button x:Name="btnSiguiente" Content="Siguiente" Width="75" Margin="3" Style="{StaticResource EstiloBoton}" Click="btnSiguiente_Click" />
            <Button x:Name="btnUltimo" Content="Último" Width="75" Margin="3" Style="{StaticResource EstiloBoton}" Click="btnUltimo_Click" />
            <Button x:Name="btnSalir" Content="Salir" Width="75" Margin="90,3,3,3" Click="btnSalir_Click" Style="{StaticResource EstiloBoton}"/>
        </StackPanel>
    </Grid>
</Window>
