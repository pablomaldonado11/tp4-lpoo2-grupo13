<Window x:Class="Vistas.PresentacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="El Roble" Height="300" Width="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid Background="#FF2B2B2B">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="El Roble" FontSize="48" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="Mueblería" FontSize="22"
                       Foreground="LightGray" HorizontalAlignment="Center"/>
            <Button Content="Entrar" Width="100" Height="30" Margin="0,30,0,0"
                    Click="btnEntrar_Click"/>
        </StackPanel>
    </Grid>
</Window>