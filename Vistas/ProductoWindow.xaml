<Window x:Class="Vistas.ProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ABM de Productos" Height="650" Width="800"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Productos" FontSize="20"
                   FontWeight="Bold" Margin="5"/>

        <WrapPanel Grid.Row="1" Margin="0,8">
            <Button x:Name="btnNuevo" Content="Nuevo" Width="85" Height="30"
                    Margin="3" Click="btnNuevo_Click"
                    Style="{StaticResource EstiloBotonProducto}"/>
            <Button x:Name="btnModificar" Content="Modificar" Width="85" Height="30"
                    Margin="3" Click="btnModificar_Click"
                    Style="{StaticResource EstiloBotonProducto}"/>
            <Button x:Name="btnEliminar" Content="Eliminar" Width="85" Height="30"
                    Margin="3" Click="btnEliminar_Click"
                    Style="{StaticResource EstiloBotonProducto}"/>
            <Button x:Name="btnGuardar" Content="Guardar" Width="85" Height="30"
                    Margin="3" Click="btnGuardar_Click"
                    Style="{StaticResource EstiloBotonProducto}"/>
            <Button x:Name="btnCancelar" Content="Cancelar" Width="85" Height="30"
                    Margin="3" Click="btnCancelar_Click"
                    Style="{StaticResource EstiloBotonProducto}"/>
        </WrapPanel>

        <Grid Grid.Row="2" Margin="30,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="Código:"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtCodProducto"
                     MaxLength="20" Style="{StaticResource EstiloTextBox}"
                     Text="{Binding CodProducto, UpdateSourceTrigger=PropertyChanged,
                            ValidatesOnDataErrors=True}"/>

            <Label Grid.Row="1" Content="Categoría:"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtCategoria"
                     MaxLength="50" Style="{StaticResource EstiloTextBox}"
                     Text="{Binding Categoria, UpdateSourceTrigger=PropertyChanged,
                            ValidatesOnDataErrors=True}"/>

            <Label Grid.Row="2" Content="Color:"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtColor"
                     MaxLength="30" Style="{StaticResource EstiloTextBox}"
                     Text="{Binding Color, UpdateSourceTrigger=PropertyChanged,
                            ValidatesOnDataErrors=True}"/>

            <Label Grid.Row="3" Content="Descripción:"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtDescripcion"
                     MaxLength="100" Style="{StaticResource EstiloTextBox}"
                     Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged,
                            ValidatesOnDataErrors=True}"/>

            <Label Grid.Row="4" Content="Precio:"/>
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtPrecio"
                     MaxLength="12" Style="{StaticResource EstiloTextBox}"
                     Text="{Binding Precio, UpdateSourceTrigger=PropertyChanged,
                            ValidatesOnDataErrors=True}"/>
        </Grid>

        <DataGrid x:Name="dgvProductos" Grid.Row="3" Margin="5"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  SelectionChanged="dgvProductos_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding CodProducto}" Width="100"/>
                <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="130"/>
                <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="100"/>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=N2}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button x:Name="btnPrimero" Content="Primero" Width="85" Margin="3"
                    Click="btnPrimero_Click" Style="{StaticResource EstiloBotonProducto}"/>
            <Button x:Name="btnAnterior" Content="Anterior" Width="85" Margin="3"
                    Click="btnAnterior_Click" Style="{StaticResource EstiloBotonProducto}"/>
            <Button x:Name="btnSiguiente" Content="Siguiente" Width="85" Margin="3"
                    Click="btnSiguiente_Click" Style="{StaticResource EstiloBotonProducto}"/>
            <Button x:Name="btnUltimo" Content="Último" Width="85" Margin="3"
                    Click="btnUltimo_Click" Style="{StaticResource EstiloBotonProducto}"/>
            <Button x:Name="btnSalir" Content="Salir" Width="85" Margin="80,3,3,3"
                    Click="btnSalir_Click" Style="{StaticResource EstiloBotonProducto}"/>
        </StackPanel>
    </Grid>
</Window>
