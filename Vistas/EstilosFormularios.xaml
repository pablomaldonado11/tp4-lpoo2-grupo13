<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- TP Final - Punto 1: fondo degradado para ventanas ABM y listados -->
    <Style x:Key="EstiloVentanaDegradado" TargetType="{x:Type Window}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F7FBFF" Offset="0"/>
                    <GradientStop Color="#DDEEFF" Offset="0.55"/>
                    <GradientStop Color="#C8DCF2" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TP Final - Punto 2: imágenes vectoriales sencillas para los botones -->
    <DrawingImage x:Key="IconoNuevo">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="White" Geometry="M6,0 L10,0 10,6 16,6 16,10 10,10 10,16 6,16 6,10 0,10 0,6 6,6 Z"/>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconoModificar">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="White" Geometry="M1,12 L0,16 4,15 14,5 11,2 Z M12,1 L15,4 16,3 13,0 Z"/>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconoEliminar">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="White" Geometry="M3,4 L13,4 12,16 4,16 Z M1,1 L6,1 6,0 10,0 10,1 15,1 15,3 1,3 Z"/>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconoGuardar">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="White" Geometry="M1,0 L13,0 16,3 16,16 0,16 0,0 Z"/>
                <GeometryDrawing Brush="#2A75D3" Geometry="M3,1 L11,1 11,6 3,6 Z M3,10 L13,10 13,15 3,15 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconoCancelar">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="White" Geometry="M2,0 L8,6 14,0 16,2 10,8 16,14 14,16 8,10 2,16 0,14 6,8 0,2 Z"/>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconoPrimero">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="White" Geometry="M1,1 L4,1 4,15 1,15 Z M14,1 L14,15 5,8 Z"/>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconoAnterior">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="White" Geometry="M13,1 L13,15 3,8 Z"/>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconoSiguiente">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="White" Geometry="M3,1 L13,8 3,15 Z"/>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconoUltimo">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="White" Geometry="M12,1 L15,1 15,15 12,15 Z M2,1 L11,8 2,15 Z"/>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconoSalir">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="White" Geometry="M0,1 L9,1 9,5 7,5 7,3 2,3 2,13 7,13 7,11 9,11 9,15 0,15 Z M8,6 L13,6 11,4 13,4 16,8 13,12 11,12 13,10 8,10 Z"/>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconoConfirmar">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="White" Geometry="M0,8 L3,5 7,10 14,1 16,4 7,16 Z"/>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconoImprimir">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="White" Geometry="M3,0 L13,0 13,5 3,5 Z M2,5 L14,5 16,7 16,12 13,12 13,16 3,16 3,12 0,12 0,7 Z M5,10 L11,10 11,14 5,14 Z"/>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconoVistaPrevia">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="White" Geometry="M0,8 C4,2 12,2 16,8 C12,14 4,14 0,8 Z"/>
                <GeometryDrawing Brush="#2A75D3" Geometry="M5,8 A3,3 0 1 0 11,8 A3,3 0 1 0 5,8 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconoVolver">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="White" Geometry="M7,1 L0,8 7,15 7,11 13,11 C15,11 16,10 16,8 C16,5 14,4 11,4 L7,4 Z"/>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Plantilla sencilla para mostrar un error de validación -->
    <ControlTemplate x:Key="PlantillaError">
        <DockPanel LastChildFill="True">
            <Border BorderBrush="Red" BorderThickness="1">
                <AdornedElementPlaceholder/>
            </Border>
            <TextBlock Text=" !" Foreground="Red" FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </DockPanel>
    </ControlTemplate>

    <!-- Estilo para los TextBox -->
    <Style x:Key="EstiloTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderBrush" Value="#2A75D3"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Validation.ErrorTemplate"
                Value="{StaticResource PlantillaError}"/>
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="Red"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="ToolTip"
                        Value="{Binding RelativeSource={RelativeSource Self},
                                Path=(Validation.Errors)[0].ErrorContent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Estilo general para los botones -->
    <Style x:Key="EstiloBoton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Background" Value="#2A75D3"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>

        <!-- Punto 3: desencadenador al pasar el mouse -->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="Yellow"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Punto 2: plantilla para los botones del formulario Alta de Productos -->
    <ControlTemplate x:Key="PlantillaBotonProducto" TargetType="{x:Type Button}">
        <Border x:Name="bordeBoton"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="8"
                Padding="8,4">
            <ContentPresenter
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="{TemplateBinding Content}"
                TextElement.Foreground="{TemplateBinding Foreground}"
                TextElement.FontSize="{TemplateBinding FontSize}"
                TextElement.FontWeight="{TemplateBinding FontWeight}"/>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bordeBoton" Property="Opacity" Value="0.75"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bordeBoton" Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Estilo exclusivo de Productos: reutiliza el estilo general y aplica la plantilla -->
    <Style x:Key="EstiloBotonProducto"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource EstiloBoton}">
        <Setter Property="Background" Value="#5B46C5"/>
        <Setter Property="BorderBrush" Value="#40308F"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template" Value="{StaticResource PlantillaBotonProducto}"/>
    </Style>

    <!-- La imagen se asigna mediante Tag y el texto se mantiene en Content. -->
    <ControlTemplate x:Key="PlantillaBotonConIcono" TargetType="{x:Type Button}">
        <Border x:Name="borde"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="5" Padding="6,3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Width="16" Height="16" Margin="0,0,5,0"
                       Source="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"/>
                <TextBlock Text="{TemplateBinding Content}"
                           Foreground="{TemplateBinding Foreground}"
                           FontSize="{TemplateBinding FontSize}"
                           FontWeight="{TemplateBinding FontWeight}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="borde" Property="Opacity" Value="0.75"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="borde" Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="EstiloBotonIcono" TargetType="{x:Type Button}"
           BasedOn="{StaticResource EstiloBoton}">
        <Setter Property="Template" Value="{StaticResource PlantillaBotonConIcono}"/>
    </Style>

    <Style x:Key="EstiloBotonProductoIcono" TargetType="{x:Type Button}"
           BasedOn="{StaticResource EstiloBotonProducto}">
        <Setter Property="Template" Value="{StaticResource PlantillaBotonConIcono}"/>
    </Style>

</ResourceDictionary>
