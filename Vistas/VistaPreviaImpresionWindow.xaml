<Window x:Class="Vistas.VistaPreviaImpresionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vista previa de impresión" Height="450" Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#A0A0A0" BorderThickness="1" Background="White">
            <FlowDocumentScrollViewer Name="viewerDocumento" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <FlowDocument Name="flowDoc" PagePadding="20" FontFamily="Segoe UI" FontSize="13">
                </FlowDocument>
            </FlowDocumentScrollViewer>
        </Border>

        <Button Name="btnImprimir" Grid.Row="1" Content="Imprimir" Width="120" Height="30"
                Margin="0,10,0,0" HorizontalAlignment="Center" Click="btnImprimir_Click"/>
    </Grid>
</Window>
