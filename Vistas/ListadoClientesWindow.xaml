<Window x:Class="Vistas.ListadoClientesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Listado de Clientes" Height="350" Width="500"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Filtrar por apellido:"/>
            <TextBox Name="txtFiltroApellido" Width="200"
                     TextChanged="txtFiltroApellido_TextChanged"/>
        </StackPanel>

        <DataGrid Name="dgClientes" Grid.Row="1"
                  AutoGenerateColumns="True" IsReadOnly="True"/>
    </Grid>
</Window>