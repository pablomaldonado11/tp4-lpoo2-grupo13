<Window x:Class="Vistas.ListadoClientesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Listado de Clientes" Height="390" Width="500"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Filtrar por apellido:"/>
            <TextBox Name="txtFiltroApellido" Width="200"
                     TextChanged="txtFiltroApellido_TextChanged"/>
        </StackPanel>

        <DataGrid Name="dgClientes" Grid.Row="1"
                  AutoGenerateColumns="True" IsReadOnly="True"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="btnVistaPrevia" Content="Vista Previa"
                    Width="110" Height="30" Margin="3"
                    Click="btnVistaPrevia_Click"/>
            <Button Name="btnVolver" Content="Volver"
                    Width="80" Height="30" Margin="3"
                    Click="btnVolver_Click"/>
        </StackPanel>
    </Grid>
</Window>
