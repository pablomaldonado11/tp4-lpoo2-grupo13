<Window x:Class="Vistas.ProveedorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alta de Proveedores" Height="420" Width="650"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Alta de Proveedores" FontSize="20" FontWeight="Bold" Margin="5"/>
        <WrapPanel Grid.Row="1" Margin="0,8">
            <Button x:Name="btnNuevo" Content="Nuevo" Width="75" Height="30" Margin="3" Click="btnNuevo_Click" Style="{StaticResource EstiloBoton}"/>
            <Button x:Name="btnModificar" Click="btnModificar_Click" Content="Modificar" Width="75" Height="30" Margin="3" Style="{StaticResource EstiloBoton}"/>
            <Button x:Name="btnEliminar" Click="btnEliminar_Click" Content="Eliminar" Width="75" Height="30" Margin="3" Style="{StaticResource EstiloBoton}"/>
            <Button x:Name="btnGuardar" Content="Guardar" Width="75" Height="30" Margin="3" Click="btnGuardar_Click" Style="{StaticResource EstiloBoton}"/>
            <Button x:Name="btnCancelar" Content="Cancelar" Width="75" Height="30" Margin="3" Click="btnCancelar_Click" Style="{StaticResource EstiloBoton}"/>
        </WrapPanel>
        <Grid Grid.Row="2" Margin="30,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/></Grid.RowDefinitions>
            <Label Grid.Row="0" Content="CUIT:"/><TextBox Grid.Row="0" Grid.Column="1" x:Name="txtCUIT" Height="25" MaxLength="11" Style="{StaticResource EstiloTextBox}"/>
            <Label Grid.Row="1" Content="Razón social:"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="txtRazonSocial" Height="25" MaxLength="80" Style="{StaticResource EstiloTextBox}"/>
            <Label Grid.Row="2" Content="Domicilio:"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="txtDomicilio" Height="25" MaxLength="100" Style="{StaticResource EstiloTextBox}"/>
            <Label Grid.Row="3" Content="Teléfono:"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="txtTelefono" Height="25" MaxLength="15" Style="{StaticResource EstiloTextBox}"/>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button x:Name="btnPrimero" Click="btnPrimero_Click" Content="Primero" Width="75" Margin="3" Style="{StaticResource EstiloBoton}"/>
            <Button x:Name="btnAnterior" Click="btnAnterior_Click" Content="Anterior" Width="75" Margin="3" Style="{StaticResource EstiloBoton}"/>
            <Button x:Name="btnSiguiente" Click="btnSiguiente_Click" Content="Siguiente" Width="75" Margin="3" Style="{StaticResource EstiloBoton}"/>
            <Button x:Name="btnUltimo" Click="btnUltimo_Click" Content="Último" Width="75" Margin="3" Style="{StaticResource EstiloBoton}"/>
            <Button x:Name="btnListar" Content="Listar" Width="75" Margin="3" Click="btnListar_Click" Style="{StaticResource EstiloBoton}"/>
            <Button x:Name="btnSalir" Content="Salir" Width="75" Margin="10,3,3,3" Click="btnSalir_Click" Style="{StaticResource EstiloBoton}"/>
        </StackPanel>
    </Grid>
</Window>
