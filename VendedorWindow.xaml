<Window x:Class="Vistas.VendedorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ABM de Vendedores" Height="570" Width="700"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="145"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Vendedores" FontSize="20"
                   FontWeight="Bold" Margin="5"/>

        <WrapPanel Grid.Row="1" Margin="0,8">
            <Button x:Name="btnNuevo" Content="Nuevo" Width="85" Height="30"
                    Margin="3" Click="btnNuevo_Click" Style="{StaticResource EstiloBoton}"/>
            <Button x:Name="btnModificar" Content="Modificar" Width="85" Height="30"
                    Margin="3" Click="btnModificar_Click" Style="{StaticResource EstiloBoton}"/>
            <Button x:Name="btnEliminar" Content="Eliminar" Width="85" Height="30"
                    Margin="3" Click="btnEliminar_Click" Style="{StaticResource EstiloBoton}"/>
            <Button x:Name="btnGuardar" Content="Guardar" Width="85" Height="30"
                    Margin="3" Click="btnGuardar_Click" Style="{StaticResource EstiloBoton}"/>
            <Button x:Name="btnCancelar" Content="Cancelar" Width="85" Height="30"
                    Margin="3" Click="btnCancelar_Click" Style="{StaticResource EstiloBoton}"/>
        </WrapPanel>

        <Grid Grid.Row="2" Margin="30,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="Legajo:"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtLegajo"
                     MaxLength="20" Style="{StaticResource EstiloTextBox}"/>
            <Label Grid.Row="1" Content="Apellido:"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtApellido"
                     MaxLength="50" Style="{StaticResource EstiloTextBox}"/>
            <Label Grid.Row="2" Content="Nombre:"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtNombre"
                     MaxLength="50" Style="{StaticResource EstiloTextBox}"/>
        </Grid>

        <DataGrid x:Name="dgvVendedores" Grid.Row="3" Margin="5"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  SelectionChanged="dgvVendedores_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Legajo" Binding="{Binding Legajo}" Width="130"/>
                <DataGridTextColumn Header="Apellido" Binding="{Binding Apellido}" Width="*"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button x:Name="btnPrimero" Content="Primero" Width="85" Margin="3"
                    Click="btnPrimero_Click" Style="{StaticResource EstiloBoton}"/>
            <Button x:Name="btnAnterior" Content="Anterior" Width="85" Margin="3"
                    Click="btnAnterior_Click" Style="{StaticResource EstiloBoton}"/>
            <Button x:Name="btnSiguiente" Content="Siguiente" Width="85" Margin="3"
                    Click="btnSiguiente_Click" Style="{StaticResource EstiloBoton}"/>
            <Button x:Name="btnUltimo" Content="Último" Width="85" Margin="3"
                    Click="btnUltimo_Click" Style="{StaticResource EstiloBoton}"/>
            <Button x:Name="btnSalir" Content="Salir" Width="85" Margin="50,3,3,3"
                    Click="btnSalir_Click" Style="{StaticResource EstiloBoton}"/>
        </StackPanel>
    </Grid>
</Window>
